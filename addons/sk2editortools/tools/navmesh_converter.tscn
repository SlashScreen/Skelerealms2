[gd_scene format=3 uid="uid://bfwa1megx55wa"]

[ext_resource type="NavigationMesh" uid="uid://cvpf77u3djxd8" path="res://assets/navmeshes/todd_test.res" id="1_e0lyu"]
[ext_resource type="NavigationMesh" uid="uid://cm6sp4cows8f1" path="res://assets/navmeshes/island.res" id="2_yf67c"]

[sub_resource type="GDScript" id="GDScript_ebb26"]
script/source = "extends Node


var regex := RegEx.create_from_string(\".*/(.*)\\\\.(?:res|tres)\")

@export_dir var output := \"res://navgraphs/\"
@export var to_convert: Array[NavigationMesh]

@onready var label: Label = $VBoxContainer/Label
@onready var progress_bar: ProgressBar = $VBoxContainer/ProgressBar


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	_bake.call_deferred()


func _bake() -> void:
	var baker := SimpleNavGraphBuilder.new()

	var i := 1
	for nv: NavigationMesh in to_convert:
		var r_match := regex.search(nv.resource_path)
		var sn := baker.build_simple_nav_graph(nv)
		ResourceSaver.save(sn, output + \"%s.res\" % r_match.get_string(1))

		progress_bar.value = i / float(to_convert.size()) * 100.0
		i += 1

	label.text = \"Ding!\"
"

[node name="NavmeshConverter" type="Node" unique_id=753314981]
script = SubResource("GDScript_ebb26")
to_convert = Array[NavigationMesh]([ExtResource("1_e0lyu"), ExtResource("2_yf67c")])

