[ext_resource type="NavigationMesh" uid="uid://cm6sp4cows8f1" path="res://terrain_resources/island/navmesh.res" id="1_ytrt7"]

[sub_resource type="GDScript" id="GDScript_ebb26"]
script/source = "extends Node


const OUTPUT := \"res://navgraphs/\"


@export var to_convert: Array[NavigationMesh]


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var baker := SimpleNavGraphBuilder.new()
	for nv: NavigationMesh in to_convert:
		var sn := baker.build_simple_nav_graph(nv)
		ResourceSaver.save(sn, OUTPUT + \"graph.res\") # TODO: extract name with regex
"

[node name="Converter" type="Node" unique_id=753314981]
script = SubResource("GDScript_ebb26")
to_convert = Array[NavigationMesh]([ExtResource("1_ytrt7")])
